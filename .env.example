# SOULS Frontend Environment Configuration

# API Base URL
REACT_APP_API_URL=http://localhost:3000/api

# Environment
REACT_APP_ENV=development

# Analytics
REACT_APP_ANALYTICS_ENABLED=true

# Feature Flags
REACT_APP_FEATURE_BETA_EDITOR=true
REACT_APP_FEATURE_CLOUD_SYNC=false

# GIPHY (optional)
REACT_APP_GIPHY_API_KEY=

# Debug
REACT_APP_DEBUG=false
