{
  "name": "souls-app",
  "version": "1.0.0",
  "description": "SOULS - Luxury Social Lifestyle App",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "backend": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "docker:build": "docker build -f backend/Dockerfile -t souls-backend:latest .",
    "docker:run": "docker run -p 3000:3000 --env-file .env souls-backend:latest"
  },
  "dependencies": {
    "expo": "^49.0.0",
    "expo-camera": "^13.4.0",
    "expo-media-library": "^15.4.0",
    "expo-router": "^2.0.0",
    "expo-status-bar": "^1.10.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-screens": "^3.27.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "axios": "^1.6.0",
    "zustand": "^4.4.0",
    "@react-native-async-storage/async-storage": "^1.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "typescript": "^5.2.0"
  }
}
